{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the main window may do.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-ask",
    "dialog:allow-message",
    "opener:allow-open-url",
    "opener:allow-reveal-item-in-dir",
    "opener:allow-open-path",
    "updater:default",
    "process:allow-restart"
  ]
}
